# Applied to a COPY of the normal sdkconfig by tools/build_watchdog_diagnostics.sh.
# Task stacks, watchdog timeout, PSRAM and light sleep retain their normal settings.
# CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
# CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH is not set
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_STACK_SIZE=2048
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=64
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_COREDUMP_DECODE_INFO=y
# CONFIG_ESP_COREDUMP_DECODE_DISABLE is not set
# Do not walk the heap from panic context: a halted CPU can own a heap lock.
# Task registers/stacks and COREDUMP_DRAM_ATTR flight recorder remain captured.
# CONFIG_ESP_COREDUMP_CAPTURE_DRAM is not set
CONFIG_FLUE_DIAG_RECORDER=y
# CONFIG_FLUE_DIAG_CRASH_TEST is not set
CONFIG_ESP_PANIC_HANDLER_IRAM=y
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# CONFIG_HEAP_POISONING_DISABLED is not set
CONFIG_HEAP_POISONING_LIGHT=y
# CONFIG_HEAP_POISONING_COMPREHENSIVE is not set
