# Build guarded local copies; preserve object basenames for IDF linker fragments.
if(CONFIG_IDF_TARGET_ESP32 AND CONFIG_SPIRAM AND CONFIG_ESP32_ECO3_CACHE_LOCK_FIX)
    if(CONFIG_FLUE_DIAG_TRACE_SDK)
        message(FATAL_ERROR "Disable temporary SDK tracing when testing the sleep backport")
    endif()
    set(backport_script "${CMAKE_CURRENT_LIST_DIR}/../tools/backport_sleep_livelock.py")
    set(backport_dir "${CMAKE_CURRENT_BINARY_DIR}/sleep_backport")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${backport_script}")
    execute_process(COMMAND "${PYTHON}" "${backport_script}" "${IDF_PATH}" "${backport_dir}"
                    RESULT_VARIABLE backport_result)
    if(NOT backport_result EQUAL 0)
        message(FATAL_ERROR "Sleep backport source guards failed; review SDK upgrade")
    endif()
    foreach(pair "esp_hw_support|sleep_modes.c" "esp_hw_support|chip_info.c" "esp_system|int_wdt.c")
        string(REPLACE "|" ";" fields "${pair}")
        list(GET fields 0 component)
        list(GET fields 1 filename)
        idf_component_get_property(lib ${component} COMPONENT_LIB)
        get_target_property(sources ${lib} SOURCES)
        set(found FALSE)
        foreach(source IN LISTS sources)
            get_filename_component(basename "${source}" NAME)
            if(basename STREQUAL filename)
                list(REMOVE_ITEM sources "${source}")
                set(found TRUE)
            endif()
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "Cannot replace SDK source ${filename}")
        endif()
        set_property(TARGET ${lib} PROPERTY SOURCES "${sources}")
        target_sources(${lib} PRIVATE "${backport_dir}/${filename}")
    endforeach()
endif()
